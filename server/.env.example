# ─── Server ───────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────
# Use DATABASE_URL or the individual vars below:
# DATABASE_URL=postgres://user:pass@localhost:5432/taller2
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taller2
DB_SSL=false

# ─── JWT ──────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=8h

# ─── Email (SMTP) ────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ventas@taller2.com
