# ╔══════════════════════════════════════════════════════════════╗
# ║  Taller 2.0 – .gitignore                                   ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Dependencias ────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz

# ── Builds y compilados ────────────────────────────────────────
dist/
build/
.next/
out/
*.tsbuildinfo

# ── Variables de entorno ────────────────────────────────────────
# ⚠️  Nunca subir credenciales al repositorio
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# ✅  El template SÍ se versiona
!.env.example

# ── Testing y cobertura ────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Docker ──────────────────────────────────────────────────────
postgres_data/

# ── IDEs y editores ────────────────────────────────────────────
# VSCode – ignorar todo excepto configuración compartida
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml

# Vim / Neovim
*.swp
*.swo
*~

# ── Sistema operativo ──────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ── Misceláneos ─────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
.cache/
.parcel-cache/
.turbo/
.vercel/

# Prisma
prisma/*.db
prisma/*.db-journal

# Archivos temporales de uploads
uploads/tmp/
temp/
