# ╔══════════════════════════════════════════════════════════════╗
# ║  Taller 2.0 – Variables de Entorno                         ║
# ║  Copia este archivo como .env y completa los valores        ║
# ║  $ cp .env.example .env                                    ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Base de Datos (PostgreSQL) ──────────────────────────────────
# URL de conexión completa (usada por Prisma / TypeORM)
DATABASE_URL=postgresql://taller_admin:taller_secret@localhost:5432/taller2

# Credenciales individuales (usadas por docker-compose)
POSTGRES_USER=taller_admin
POSTGRES_PASSWORD=taller_secret
POSTGRES_DB=taller2

# ── Autenticación JWT ───────────────────────────────────────────
# Clave secreta para firmar tokens (usar valor largo y aleatorio en producción)
JWT_SECRET=super-secret-key-change-in-production
# Tiempo de expiración del token (ej: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# ── Servidor Express ───────────────────────────────────────────
# Puerto en el que corre el servidor API
PORT=4000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# ── Correo Electrónico (SMTP) ──────────────────────────────────
# Host del servidor SMTP (ej: smtp.gmail.com, smtp.mailtrap.io)
SMTP_HOST=smtp.mailtrap.io
# Puerto SMTP (587 para TLS, 465 para SSL)
SMTP_PORT=587
# Credenciales del servicio de correo
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ── Cliente Next.js ────────────────────────────────────────────
# URL pública de la API (accesible desde el navegador)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
